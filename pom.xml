<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.java21.data2flow</groupId>
    <artifactId>data2flow-contracts-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>data2flow-contracts-parent</name>
    <description>data2flow 공통 계약: 의존성 버전 목록(BOM)과 공통 응답·오류·신원 헤더·메시지 계약 (design/conventions.md §3)</description>

    <modules>
        <module>data2flow-bom</module>
        <module>data2flow-contracts</module>
    </modules>

    <properties>
        <revision>0.1.0-SNAPSHOT</revision>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.1.1</spring-boot.version>
    </properties>

    <distributionManagement>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/data2flow/data2flow-contracts</url>
        </repository>
    </distributionManagement>

    <build>
        <plugins>
            <!-- ${revision}을 설치·배포되는 POM에 실제 값으로 남긴다 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.7.3</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution><id>flatten</id><phase>process-resources</phase><goals><goal>flatten</goal></goals></execution>
                    <execution><id>flatten-clean</id><phase>clean</phase><goals><goal>clean</goal></goals></execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
