{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data2flow.java21.net/schemas/flow-definition.v1.json",
  "title": "FlowDefinition v1 (FLW-api §5, flows.definition)",
  "description": "플로우 정의. 노드 config 모양은 노드 카탈로그(flow-node-type.v1.json의 configSchema)가 정한다. 노드 ID 중복·없는 노드 연결은 FlowDefinition.structuralErrors()가 본다.",
  "type": "object",
  "required": [
    "schema",
    "nodes",
    "wires"
  ],
  "properties": {
    "schema": {
      "const": "data2flow.flow-definition/v1"
    },
    "mode": {
      "type": "object",
      "properties": {
        "concurrency": {
          "type": "string",
          "minLength": 1
        },
        "keyBy": {
          "type": "string"
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string"
          },
          "initial": {}
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "wires": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "type": "string"
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "subflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)+$"
        },
        "typeVersion": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "config": {
          "type": "object"
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retry": {
          "type": "object"
        },
        "position": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "disabled": {
          "type": "boolean"
        }
      }
    }
  }
}
