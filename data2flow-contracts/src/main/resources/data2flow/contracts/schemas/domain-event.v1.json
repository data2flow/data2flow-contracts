  "$defs": {
    "deviceChanged": {
      "type": "object",
      "required": [
        "deviceId",
        "change",
        "version"
      ],
      "properties": {
        "deviceId": {
          "type": "integer",
          "minimum": 1
        },
        "change": {
          "enum": [
            "CREATED",
            "APPROVED",
            "UPDATED",
            "ACTIVATED",
            "DEACTIVATED",
            "DELETED",
            "REPLACED"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "modelId": {
          "type": [
            "string",
            "null"
          ]
        },
        "spaceId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "deviceConnectivityChanged": {
      "type": "object",
      "required": [
        "deviceId",
        "to",
        "lastSeenAt",
        "expectedIntervalSec",
        "multiplier"
      ],
      "properties": {
        "deviceId": {
          "type": "integer",
          "minimum": 1
        },
        "from": {
          "enum": [
            "ONLINE",
            "OFFLINE",
            null
          ]
        },
        "to": {
          "enum": [
            "ONLINE",
            "OFFLINE"
          ]
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time"
        },
        "expectedIntervalSec": {
          "type": "integer",
          "minimum": 1
        },
        "multiplier": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "devicePendingCreated": {
      "type": "object",
      "required": [
        "deviceId",
        "sourceId",
        "externalId",
        "firstSeenAt"
      ],
      "properties": {
        "deviceId": {
          "type": "integer",
          "minimum": 1
        },
        "sourceId": {
          "type": "integer",
          "minimum": 1
        },
        "externalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "firstSeenAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "spaceChanged": {
      "type": "object",
      "required": [
        "spaceId",
        "change"
      ],
      "properties": {
        "spaceId": {
          "type": "integer",
          "minimum": 1
        },
        "change": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "groupMembershipChanged": {
      "type": "object",
      "required": [
        "groupId",
        "added",
        "removed"
      ],
      "properties": {
        "groupId": {
          "type": "integer",
          "minimum": 1
        },
        "added": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "sourceRuntimeReported": {
      "type": "object",
      "required": [
        "sourceId",
