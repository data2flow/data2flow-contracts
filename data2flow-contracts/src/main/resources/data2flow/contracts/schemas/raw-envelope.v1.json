{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data2flow.java21.net/schemas/raw-envelope.v1.json",
  "title": "RawEnvelope v1 (EVT-ING-01, data2flow.raw)",
  "description": "원본 수신 메시지. 소비자는 모르는 필드를 무시한다.",
  "type": "object",
  "required": ["v", "messageId", "organizationId", "sourceId", "sourceType", "payload", "receivedAt", "ingressInstance", "dedupKey", "virtual"],
  "properties": {
    "v": { "const": 1 },
    "messageId": { "type": "string", "format": "uuid" },
    "organizationId": { "type": "integer", "minimum": 1 },
    "sourceId": { "type": "integer", "minimum": 1 },
    "sourceType": { "type": "string", "minLength": 1, "maxLength": 20 },
    "topic": { "type": ["string", "null"], "maxLength": 512 },
    "payload": { "type": "string", "contentEncoding": "base64" },
    "receivedAt": { "type": "string", "format": "date-time" },
    "ingressInstance": { "type": "string", "minLength": 1 },
    "dedupKey": { "type": "string", "minLength": 1, "maxLength": 128 },
    "virtual": { "type": "boolean" },
    "simRunId": { "type": ["integer", "null"], "minimum": 1 },
    "signatureStatus": { "type": ["string", "null"], "enum": ["VERIFIED", "UNSIGNED", "INVALID", null], "description": "플랫폼 브로커 기기 payload 서명 검증 결과(DSC-03.03·03.05). PLATFORM_BROKER 소스만, 그 밖에는 생략" }
  }
}
