<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.java21.data2flow</groupId>
        <artifactId>data2flow-contracts-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>data2flow-bom</artifactId>
    <packaging>pom</packaging>
    <name>data2flow-bom</name>
    <description>서비스가 버전 없이 이름만 쓰도록 공통 의존성 버전을 한 곳에서 정한다. Spring Boot가 관리하는 라이브러리(Testcontainers, Flyway, PostgreSQL 드라이버 등)는 여기서 다시 정하지 않는다. 라이선스는 design/oss-stack.md에서 확인한 것만 넣는다(ADR-018).</description>

    <properties>
        <hivemq-mqtt-client.version>1.3.17</hivemq-mqtt-client.version>
        <springdoc.version>3.1.1</springdoc.version>
        <!-- archunit.version·json-schema-validator.version·graalvm-polyglot.version은 부모 POM에서 정한다(contracts·contracts-test·script-sandbox와 같은 값) -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>net.java21.data2flow</groupId>
                <artifactId>data2flow-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 테스트 키트: 서비스는 test 범위로 쓴다(공통 ArchUnit 규칙) -->
            <dependency>
                <groupId>net.java21.data2flow</groupId>
                <artifactId>data2flow-contracts-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 사용자 JavaScript 샌드박스 공용 모듈(SCR-02, FLW-02 JS 함수 노드, ADR-046). GraalJS 커뮤니티판을 함께 가져온다 -->
            <dependency>
                <groupId>net.java21.data2flow</groupId>
                <artifactId>data2flow-script-sandbox</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.graalvm.polyglot</groupId>
                <artifactId>polyglot</artifactId>
                <version>${graalvm-polyglot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.graalvm.polyglot</groupId>
                <artifactId>js-community</artifactId>
                <version>${graalvm-polyglot.version}</version>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>com.hivemq</groupId>
                <artifactId>hivemq-mqtt-client</artifactId>
                <version>${hivemq-mqtt-client.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- 메시지 계약 JSON Schema 검증(테스트 키트 MessageSchemas): Apache-2.0 -->
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>${json-schema-validator.version}</version>
            </dependency>
            <!-- ArchUnit: Apache-2.0 -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
